<%- include('partials/head', { title: 'Accueil' }) %>
<%- include('partials/navbar') %>

<main class="flex-1 mx-auto max-w-7xl w-full px-6 lg:px-8 py-12">
    <div class="text-center mb-12">
        <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">Les avis de nos clients</h1>
        <p class="mt-4 text-lg text-gray-400">Découvrez ce que nos clients pensent de nous.</p>
        <a href="/avis/add"
           class="mt-6 inline-block rounded-md bg-indigo-500 px-5 py-2.5 text-sm font-semibold text-white hover:bg-indigo-400 transition-colors">
            Laisser un avis
        </a>
    </div>

    <% if (avis.length === 0) { %>
        <div class="text-center py-16 text-gray-500">
            <p class="text-lg">Aucun avis pour le moment.</p>
            <p class="text-sm mt-1">Soyez le premier à donner votre avis !</p>
        </div>
    <% } else { %>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            <% avis.forEach(function(a) { %>
            <article class="rounded-xl bg-white/5 ring-1 ring-white/10 p-6 flex flex-col gap-3 hover:bg-white/8 transition-colors">
                <div class="flex items-center justify-between">
                    <div class="flex gap-0.5">
                        <% for (let i = 1; i <= 5; i++) { %>
                        <span class="<%= i <= a.rating ? 'text-yellow-400' : 'text-gray-600' %> text-lg">&#9733;</span>
                        <% } %>
                    </div>
                    <time class="text-xs text-gray-500">
                        <%= new Date(a.createdAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                    </time>
                </div>
                <p class="text-sm text-gray-300 line-clamp-4 flex-1"><%= a.description %></p>
                <div class="flex items-center justify-between pt-2 border-t border-white/10">
                    <span class="text-sm font-medium text-white"><%= a.author %></span>
                    <a href="/avis/<%= a.id %>" class="text-xs text-indigo-400 hover:text-indigo-300">Voir &rarr;</a>
                </div>
            </article>
            <% }) %>
        </div>
    <% } %>
</main>

<%- include('partials/footer') %>
