<%- include('partials/head', { title: 'Mot de passe oublié' }) %>
<%- include('partials/navbar') %>

<main class="flex-1 flex items-center justify-center px-6 py-16">
    <div class="w-full max-w-sm">
        <h1 class="text-2xl font-bold text-center text-white mb-2">Mot de passe oublié</h1>
        <p class="text-center text-sm text-gray-400 mb-8">Entrez votre email pour recevoir un lien de réinitialisation.</p>

        <% if (success) { %>
        <div class="mb-4 rounded-md bg-green-500/10 border border-green-500/20 px-4 py-3 text-sm text-green-400">
            <%= success %>
        </div>
        <% } %>

        <% if (error) { %>
        <div class="mb-4 rounded-md bg-red-500/10 border border-red-500/20 px-4 py-3 text-sm text-red-400">
            <%= error %>
        </div>
        <% } %>

        <% if (!success) { %>
        <form method="POST" action="/password-forgot" class="space-y-5">
            <div>
                <label for="email" class="block text-sm font-medium text-gray-300 mb-1.5">Adresse email</label>
                <input type="email" id="email" name="email" required autocomplete="email"
                       class="w-full rounded-md bg-white/5 border border-white/10 px-3 py-2 text-white placeholder-gray-500 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 text-sm" />
            </div>

            <button type="submit"
                    class="w-full rounded-md bg-indigo-500 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-400 transition-colors">
                Envoyer le lien
            </button>
        </form>
        <% } %>

        <p class="mt-6 text-center text-sm text-gray-500">
            <a href="/login" class="text-indigo-400 hover:text-indigo-300">&larr; Retour à la connexion</a>
        </p>
    </div>
</main>

<%- include('partials/footer') %>
