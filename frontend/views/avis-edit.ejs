<%- include('partials/head', { title: 'Modifier l\'avis' }) %>
<%- include('partials/navbar') %>

<main class="flex-1 mx-auto max-w-xl w-full px-6 lg:px-8 py-12">
    <a href="/avis/<%= avis.id %>" class="inline-flex items-center text-sm text-gray-400 hover:text-white mb-8">
        &larr; Retour à l'avis
    </a>

    <h1 class="text-2xl font-bold text-white mb-8">Modifier mon avis</h1>

    <% if (error) { %>
    <div class="mb-6 rounded-md bg-red-500/10 border border-red-500/20 px-4 py-3 text-sm text-red-400">
        <%= error %>
    </div>
    <% } %>

    <form method="POST" action="/avis/edit/<%= avis.id %>" class="space-y-5">
        <div>
            <label class="block text-sm font-medium text-gray-300 mb-2">Note</label>
            <div class="flex gap-1" id="star-container">
                <% for (let i = 1; i <= 5; i++) { %>
                <button type="button" data-rating="<%= i %>"
                        class="star-btn text-3xl <%= i <= avis.rating ? 'text-yellow-400' : 'text-gray-500' %> hover:text-yellow-300 focus:outline-none">&#9733;</button>
                <% } %>
            </div>
            <input type="hidden" name="rating" id="ratingInput" value="<%= avis.rating %>">
        </div>

        <div>
            <label for="description" class="block text-sm font-medium text-gray-300 mb-1.5">
                Description <span class="text-gray-500 text-xs">(min. 10 caractères)</span>
            </label>
            <textarea id="description" name="description" rows="5" required minlength="10"
                      class="w-full rounded-md bg-white/5 border border-white/10 px-3 py-2 text-white placeholder-gray-500 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 text-sm resize-none"
                      oninput="document.getElementById('char-count').textContent = this.value.length"><%= avis.description %></textarea>
            <p class="mt-1 text-xs text-gray-500"><span id="char-count"><%= avis.description ? avis.description.length : 0 %></span> caractères</p>
        </div>

        <div class="flex gap-3">
            <button type="submit"
                    class="flex-1 rounded-md bg-indigo-500 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-400 transition-colors">
                Enregistrer les modifications
            </button>
            <a href="/avis/<%= avis.id %>"
               class="rounded-md bg-white/10 px-4 py-2.5 text-sm font-semibold text-gray-300 hover:bg-white/20 transition-colors">
                Annuler
            </a>
        </div>
    </form>
</main>

<script>
    (function () {
        const stars = document.querySelectorAll('.star-btn');
        const input = document.getElementById('ratingInput');

        function paint(value) {
            stars.forEach(s => {
                const r = parseInt(s.dataset.rating);
                s.classList.toggle('text-yellow-400', r <= value);
                s.classList.toggle('text-gray-500', r > value);
            });
        }

        stars.forEach(s => {
            s.addEventListener('click', () => {
                input.value = s.dataset.rating;
                paint(parseInt(s.dataset.rating));
            });
            s.addEventListener('mouseenter', () => paint(parseInt(s.dataset.rating)));
            s.addEventListener('mouseleave', () => paint(parseInt(input.value) || 0));
        });
    })();
</script>

<%- include('partials/footer') %>
