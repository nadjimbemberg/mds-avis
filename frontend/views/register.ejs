<%- include('partials/head', { title: 'Inscription' }) %>
<%- include('partials/navbar') %>

<main class="flex-1 flex items-center justify-center px-6 py-16">
    <div class="w-full max-w-sm">
        <h1 class="text-2xl font-bold text-center text-white mb-8">Créer un compte</h1>

        <% if (error) { %>
        <div class="mb-4 rounded-md bg-red-500/10 border border-red-500/20 px-4 py-3 text-sm text-red-400">
            <%= error %>
        </div>
        <% } %>

        <form method="POST" action="/register" class="space-y-5">
            <div>
                <label for="username" class="block text-sm font-medium text-gray-300 mb-1.5">Nom d'utilisateur</label>
                <input type="text" id="username" name="username" required
                       value="<%= values.username || '' %>"
                       class="w-full rounded-md bg-white/5 border border-white/10 px-3 py-2 text-white placeholder-gray-500 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 text-sm" />
            </div>

            <div>
                <label for="email" class="block text-sm font-medium text-gray-300 mb-1.5">Adresse email</label>
                <input type="email" id="email" name="email" required autocomplete="email"
                       value="<%= values.email || '' %>"
                       class="w-full rounded-md bg-white/5 border border-white/10 px-3 py-2 text-white placeholder-gray-500 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 text-sm" />
            </div>

            <div>
                <label for="password" class="block text-sm font-medium text-gray-300 mb-1.5">Mot de passe</label>
                <input type="password" id="password" name="password" required autocomplete="new-password"
                       class="w-full rounded-md bg-white/5 border border-white/10 px-3 py-2 text-white placeholder-gray-500 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 text-sm" />
            </div>

            <div>
                <label for="confirmPassword" class="block text-sm font-medium text-gray-300 mb-1.5">Confirmer le mot de passe</label>
                <input type="password" id="confirmPassword" name="confirmPassword" required autocomplete="new-password"
                       class="w-full rounded-md bg-white/5 border border-white/10 px-3 py-2 text-white placeholder-gray-500 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 text-sm" />
            </div>

            <button type="submit"
                    class="w-full rounded-md bg-indigo-500 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-400 transition-colors">
                Créer mon compte
            </button>
        </form>

        <p class="mt-6 text-center text-sm text-gray-500">
            Déjà un compte ?
            <a href="/login" class="text-indigo-400 hover:text-indigo-300 font-medium">Se connecter</a>
        </p>
    </div>
</main>

<%- include('partials/footer') %>
