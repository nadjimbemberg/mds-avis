<%- include('partials/head', { title: 'Administration' }) %>
<%- include('partials/navbar') %>

<main class="flex-1 mx-auto max-w-4xl w-full px-6 lg:px-8 py-12">
    <h1 class="text-2xl font-bold text-white mb-2">Administration</h1>
    <p class="text-gray-400 text-sm mb-8">Avis en attente de validation</p>

    <% if (error) { %>
    <div class="mb-6 rounded-md bg-red-500/10 border border-red-500/20 px-4 py-3 text-sm text-red-400">
        <%= error %>
    </div>
    <% } %>

    <% if (avis.length === 0) { %>
    <div class="rounded-xl bg-white/5 ring-1 ring-white/10 p-10 text-center text-gray-500">
        <p class="text-lg font-medium">Aucun avis en attente</p>
        <p class="text-sm mt-1">Tous les avis ont été traités.</p>
    </div>
    <% } else { %>
    <div class="space-y-4">
        <% avis.forEach(function(a) { %>
        <article class="rounded-xl bg-white/5 ring-1 ring-white/10 p-6">
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-3 mb-2">
                        <div class="flex gap-0.5">
                            <% for (let i = 1; i <= 5; i++) { %>
                            <span class="<%= i <= a.rating ? 'text-yellow-400' : 'text-gray-600' %>">&#9733;</span>
                            <% } %>
                        </div>
                        <span class="text-xs text-gray-500">
                            <%= new Date(a.createdAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                        </span>
                    </div>
                    <p class="text-sm text-gray-300 mb-2"><%= a.description %></p>
                    <p class="text-xs text-gray-500">Par <strong class="text-gray-400"><%= a.author %></strong></p>
                </div>

                <div class="flex gap-2 shrink-0">
                    <form method="POST" action="/admin/authorize/<%= a.id %>">
                        <button type="submit"
                                class="rounded-md bg-green-500/20 px-3 py-1.5 text-sm font-medium text-green-400 hover:bg-green-500/30 transition-colors">
                            Autoriser
                        </button>
                    </form>
                    <a href="/avis/<%= a.id %>"
                       class="rounded-md bg-white/10 px-3 py-1.5 text-sm font-medium text-gray-300 hover:bg-white/20 transition-colors">
                        Voir
                    </a>
                </div>
            </div>
        </article>
        <% }) %>
    </div>
    <% } %>
</main>

<%- include('partials/footer') %>
