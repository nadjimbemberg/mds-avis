<%- include('partials/head', { title: 'Avis #' + avis.id }) %>
<%- include('partials/navbar') %>

<main class="flex-1 mx-auto max-w-2xl w-full px-6 lg:px-8 py-12">
    <a href="/" class="inline-flex items-center text-sm text-gray-400 hover:text-white mb-8">
        &larr; Retour aux avis
    </a>

    <% if (success) { %>
    <div class="mb-6 rounded-md bg-green-500/10 border border-green-500/20 px-4 py-3 text-sm text-green-400">
        <%= success %>
    </div>
    <% } %>

    <% if (!avis.authorized) { %>
    <div class="mb-6 rounded-md bg-yellow-500/10 border border-yellow-500/20 px-4 py-3 text-sm text-yellow-400">
        Cet avis est en attente de validation par un administrateur.
    </div>
    <% } %>

    <article class="rounded-xl bg-white/5 ring-1 ring-white/10 p-8">
        <div class="flex items-center justify-between mb-4">
            <div class="flex gap-0.5">
                <% for (let i = 1; i <= 5; i++) { %>
                <span class="text-xl <%= i <= avis.rating ? 'text-yellow-400' : 'text-gray-600' %>">&#9733;</span>
                <% } %>
            </div>
            <time class="text-sm text-gray-500">
                <%= new Date(avis.createdAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) %>
            </time>
        </div>

        <p class="text-gray-200 leading-relaxed mb-6"><%= avis.description %></p>

        <div class="border-t border-white/10 pt-4 flex items-center justify-between">
            <div>
                <p class="font-medium text-white"><%= avis.author %></p>
                <% if (avis.user) { %>
                <p class="text-xs text-gray-500 mt-0.5">@<%= avis.user.username %></p>
                <% } %>
            </div>
        </div>
    </article>

    <% if (isOwner) { %>
    <div class="mt-6 flex gap-3">
        <a href="/avis/edit/<%= avis.id %>"
           class="rounded-md bg-white/10 px-4 py-2 text-sm font-medium text-white hover:bg-white/20 transition-colors">
            Modifier
        </a>
        <form method="POST" action="/avis/delete/<%= avis.id %>"
              onsubmit="return confirm('Supprimer définitivement cet avis ?')">
            <button type="submit"
                    class="rounded-md bg-red-500/20 px-4 py-2 text-sm font-medium text-red-400 hover:bg-red-500/30 transition-colors">
                Supprimer
            </button>
        </form>
    </div>
    <% } %>
</main>

<%- include('partials/footer') %>
