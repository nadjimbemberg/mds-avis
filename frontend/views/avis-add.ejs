<%- include('partials/head', { title: 'Ajouter un avis' }) %>
<%- include('partials/navbar') %>

<main class="flex-1 mx-auto max-w-xl w-full px-6 lg:px-8 py-12">
    <h1 class="text-2xl font-bold text-white mb-8">Laisser un avis</h1>

    <% if (error) { %>
    <div class="mb-6 rounded-md bg-red-500/10 border border-red-500/20 px-4 py-3 text-sm text-red-400">
        <%= error %>
    </div>
    <% } %>

    <form method="POST" action="/avis/add" class="space-y-5">
        <!-- Honeypot anti-spam (caché) -->
        <div class="hidden" aria-hidden="true" style="display:none">
            <input type="text" name="_website" tabindex="-1" autocomplete="off">
        </div>

        <div>
            <label for="author" class="block text-sm font-medium text-gray-300 mb-1.5">Votre nom</label>
            <input type="text" id="author" name="author" required minlength="2"
                   value="<%= prefill.author %>"
                   class="w-full rounded-md bg-white/5 border border-white/10 px-3 py-2 text-white placeholder-gray-500 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 text-sm" />
        </div>

        <div>
            <label for="email" class="block text-sm font-medium text-gray-300 mb-1.5">Adresse email</label>
            <input type="email" id="email" name="email" required
                   value="<%= prefill.email %>"
                   class="w-full rounded-md bg-white/5 border border-white/10 px-3 py-2 text-white placeholder-gray-500 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 text-sm" />
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-300 mb-2">Note</label>
            <div class="flex gap-1" id="star-container">
                <% for (let i = 1; i <= 5; i++) { %>
                <button type="button" data-rating="<%= i %>"
                        class="star-btn text-3xl text-gray-500 hover:text-yellow-300 focus:outline-none">&#9733;</button>
                <% } %>
            </div>
            <input type="hidden" name="rating" id="ratingInput" value="0" required>
            <p id="rating-hint" class="mt-1 text-xs text-gray-500">Cliquez pour noter de 1 à 5 étoiles</p>
        </div>

        <div>
            <label for="description" class="block text-sm font-medium text-gray-300 mb-1.5">
                Description <span class="text-gray-500 text-xs">(min. 10 caractères)</span>
            </label>
            <textarea id="description" name="description" rows="5" required minlength="10"
                      class="w-full rounded-md bg-white/5 border border-white/10 px-3 py-2 text-white placeholder-gray-500 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 text-sm resize-none"
                      oninput="document.getElementById('char-count').textContent = this.value.length"></textarea>
            <p class="mt-1 text-xs text-gray-500"><span id="char-count">0</span> caractères</p>
        </div>

        <button type="submit" id="submit-btn"
                class="w-full rounded-md bg-indigo-500 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-400 transition-colors disabled:opacity-50">
            Soumettre l'avis
        </button>
    </form>
</main>

<script>
    (function () {
        const stars = document.querySelectorAll('.star-btn');
        const input = document.getElementById('ratingInput');

        function paint(value) {
            stars.forEach(s => {
                const r = parseInt(s.dataset.rating);
                s.classList.toggle('text-yellow-400', r <= value);
                s.classList.toggle('text-gray-500', r > value);
            });
        }

        stars.forEach(s => {
            s.addEventListener('click', () => {
                input.value = s.dataset.rating;
                paint(parseInt(s.dataset.rating));
            });
            s.addEventListener('mouseenter', () => paint(parseInt(s.dataset.rating)));
            s.addEventListener('mouseleave', () => paint(parseInt(input.value) || 0));
        });

        // Prevent submit without rating
        document.querySelector('form').addEventListener('submit', function (e) {
            if (!input.value || input.value === '0') {
                e.preventDefault();
                document.getElementById('rating-hint').textContent = 'Veuillez sélectionner une note.';
                document.getElementById('rating-hint').classList.add('text-red-400');
            }
        });
    })();
</script>

<%- include('partials/footer') %>
